  <!-- ===================== PÁGINA 1: CASOS DE USO ===================== -->
  <diagram id="casos-de-uso" name="Casos de Uso">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Fronteira do sistema -->
        <mxCell id="uc-sistema" value="Sistema de Controle de Gastos Pessoais" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="680" height="560" as="geometry" />
        </mxCell>

        <!-- Ator -->
        <mxCell id="uc-ator" value="Estudante&lt;br&gt;universitário" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Casos de uso principais -->
        <mxCell id="uc1" value="Registrar despesa&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(RF1)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="Registrar receita&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(RF2)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Listar despesas e receitas&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(RF3)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="270" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="Consultar resumo mensal&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(RF4)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Definir limite mensal&lt;br&gt;por categoria&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(apoio ao RF5)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="450" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Casos de uso secundários -->
        <mxCell id="uc6" value="Verificar limite&lt;br&gt;da categoria" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Emitir alerta de limite&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(RF5 – 80% / 100%)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="Calcular totais e saldo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(receitas − despesas)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Ator -> casos de uso -->
        <mxCell id="uc-a1" style="endArrow=none;html=1;" edge="1" parent="1" source="uc-ator" target="uc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-a2" style="endArrow=none;html=1;" edge="1" parent="1" source="uc-ator" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-a3" style="endArrow=none;html=1;" edge="1" parent="1" source="uc-ator" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-a4" style="endArrow=none;html=1;" edge="1" parent="1" source="uc-ator" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-a5" style="endArrow=none;html=1;" edge="1" parent="1" source="uc-ator" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- include / extend -->
        <mxCell id="uc-i1" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=10;" edge="1" parent="1" source="uc1" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-i2" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=10;" edge="1" parent="1" source="uc4" target="uc8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-i3" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=10;" edge="1" parent="1" source="uc4" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc-e1" value="«extend»&lt;br&gt;[gasto ≥ 80% do limite]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=10;" edge="1" parent="1" source="uc7" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nota RNF -->
        <mxCell id="uc-nota" value="&lt;b&gt;Requisitos não funcionais&lt;/b&gt;&lt;br&gt;RNF1: interface responsiva, legível em tela de celular.&lt;br&gt;RNF2: valores monetários no formato R$ 0,00." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="320" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
