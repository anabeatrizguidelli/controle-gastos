        <mxCell id="c-nota-rf5" value="&lt;b&gt;RF5&lt;/b&gt;: ATENCAO quando o gasto da categoria no mês ≥ 80% do limite; ESTOURADO quando ≥ 100%." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
