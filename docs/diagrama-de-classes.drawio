        <mxCell id="controle-atributos" value="- despesas: DespesaRepository&lt;br&gt;- receitas: ReceitaRepository&lt;br&gt;- categorias: CategoriaRepository" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="controle">
          <mxGeometry y="30" width="700" height="62" as="geometry" />
        </mxCell>
        <mxCell id="controle-linha" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="controle">
          <mxGeometry y="92" width="700" height="8" as="geometry" />
        </mxCell>
        <mxCell id="controle-metodos" value="+ listarDespesas(u: Usuario, mes: YearMonth): List&amp;lt;Despesa&amp;gt;&lt;br&gt;+ listarReceitas(u: Usuario, mes: YearMonth): List&amp;lt;Receita&amp;gt;&lt;br&gt;+ totalPorCategoria(u: Usuario, c: Categoria, mes: int, ano: int): double&lt;br&gt;+ totalDespesasMes(u: Usuario, mes: int, ano: int): double&lt;br&gt;+ totalReceitasMes(u: Usuario, mes: int, ano: int): double&lt;br&gt;+ calcularSaldo(u: Usuario, mes: int, ano: int): double&lt;br&gt;+ saldoAnterior(u: Usuario, mes: int, ano: int): double&lt;br&gt;+ saldoDisponivel(u: Usuario, mes: int, ano: int): double&lt;br&gt;+ totaisDoMes(u: Usuario, mes: YearMonth): TotaisMes&lt;br&gt;+ resumoPorCategoria(u: Usuario, mes: YearMonth): List&amp;lt;ResumoCategoria&amp;gt;&lt;br&gt;+ verificarAlertas(u: Usuario, mes: int, ano: int): List&amp;lt;Alerta&amp;gt;&lt;br&gt;+ historico(u: Usuario, ate: YearMonth, meses: int): List&amp;lt;ResumoMes&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="controle">
          <mxGeometry y="100" width="700" height="224" as="geometry" />
        </mxCell>

        <mxCell id="nota-rf5" value="calcularNivel() retorna:&lt;br&gt;&amp;quot;OK&amp;quot; → abaixo de 80% do limite (ou sem limite)&lt;br&gt;&amp;quot;ATENCAO&amp;quot; → a partir de 80%&lt;br&gt;&amp;quot;ESTOURADO&amp;quot; → a partir de 100%" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="330" height="84" as="geometry" />
        </mxCell>

        <mxCell id="nota-rnf2" value="Exibe valores no formato R$ 0,00&lt;br&gt;(ex.: 1250.9 → R$ 1.250,90)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1390" width="330" height="50" as="geometry" />
        </mxCell>

        <mxCell id="nota-usuario" value="&lt;b&gt;Dados por usuário&lt;/b&gt;: Categoria, Fonte, Despesa, Receita, Parcelamento, as recorrências e CodigoVerificacao pertencem a um Usuario (atributo usuario). Cada pessoa só vê os próprios dados." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1190" y="40" width="400" height="96" as="geometry" />
        </mxCell>

        <mxCell id="nota-legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Classes marcadas como “além do escopo” nos comentários do arquivo: Usuario, Fonte, Parcelamento, RecorrenciaBase, Recorrencia, RecorrenciaReceita e CodigoVerificacao (RF6 a RF17 e RNF3 a RNF8 no README).&lt;br&gt;Serviços: ver a página “Serviços”." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
