  <diagram id="diagrama-servicos" name="Serviços">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= CadastroUsuario ================= -->
        <mxCell id="cadUsuario" value="«service» CadastroUsuario" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="216" as="geometry" />
        </mxCell>
        <mxCell id="cadUsuario-atributos" value="- usuarios: UsuarioRepository&lt;br&gt;- categorias: CategoriaRepository&lt;br&gt;- fontes: FonteRepository&lt;br&gt;- codificador: PasswordEncoder" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="cadUsuario">
          <mxGeometry y="30" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cadUsuario-linha" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cadUsuario">
          <mxGeometry y="110" width="400" height="8" as="geometry" />
        </mxCell>
        <mxCell id="cadUsuario-metodos" value="+ cadastrar(nome, username, email, senha, emailConfirmado): Usuario&lt;br&gt;+ emailEmUso(email: String): boolean&lt;br&gt;+ usernameEmUso(username: String): boolean&lt;br&gt;+ &lt;u&gt;usernameValido(username: String): boolean&lt;/u&gt;&lt;br&gt;+ criarPadroes(u: Usuario): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="cadUsuario">
          <mxGeometry y="118" width="400" height="98" as="geometry" />
        </mxCell>

        <!-- ================= Verificacoes (RF7, RF8) ================= -->
        <mxCell id="verificacoes" value="«service» Verificacoes" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="verificacoes-atributos" value="+ &lt;u&gt;VALIDADE: Duration = 15 min&lt;/u&gt;&lt;br&gt;+ &lt;u&gt;INTERVALO_REENVIO: Duration = 60 s&lt;/u&gt;&lt;br&gt;+ &lt;u&gt;MAX_TENTATIVAS: int = 5&lt;/u&gt;&lt;br&gt;- codigos: CodigoVerificacaoRepository&lt;br&gt;- envio: EnvioEmail&lt;br&gt;- ativa: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="verificacoes">
          <mxGeometry y="30" width="420" height="116" as="geometry" />
        </mxCell>
        <mxCell id="verificacoes-linha" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="verificacoes">
          <mxGeometry y="146" width="420" height="8" as="geometry" />
        </mxCell>
        <mxCell id="verificacoes-metodos" value="+ enviarCodigo(u: Usuario, tipo: String): boolean&lt;br&gt;+ conferir(u: Usuario, tipo: String, digitado: String): boolean&lt;br&gt;+ confirmarEmail(login: String, codigo: String): boolean&lt;br&gt;+ reenviarConfirmacao(login: String): void&lt;br&gt;+ pedirNovaSenha(username: String, email: String): void&lt;br&gt;+ redefinirSenha(login: String, codigo: String, senhaNova: String): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;" vertex="1" parent="verificacoes">
          <mxGeometry y="154" width="420" height="116" as="geometry" />
        </mxCell>

        <!-- ================= EnvioEmail ================= -->
        <mxCell id="envio" value="«interface» EnvioEmail" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
